rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global utility functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return false; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Task Validation
    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'completed', 'priority', 'category', 'dueDate', 'createdAt', 'updatedAt', 'userId'])
        // All core fields size limits and types
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && data.completed is bool
        && data.priority in ['low', 'medium', 'high']
        && data.category is string && data.category.size() <= 100
        && data.dueDate is string && data.dueDate.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && data.userId is string && data.userId == request.auth.uid
        // Optional fields
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50));
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isSignedIn() && userId == request.auth.uid && request.auth.token.email_verified == true;
      allow list: if isSignedIn() && userId == request.auth.uid && request.auth.token.email_verified == true;
      
      allow create: if isSignedIn() 
        && request.auth.token.email_verified == true
        && userId == request.auth.uid
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().keys().size() >= 10 && incoming().keys().size() <= 11
        && incoming().id == taskId;

      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && userId == request.auth.uid
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().id == existing().id // Immutable ID
        && incoming().userId == existing().userId // Immutable UserID
        && incoming().createdAt == existing().createdAt // Immutable CreatedAt
        && (
           incoming().diff(existing()).affectedKeys().hasOnly([
             'title', 'description', 'completed', 'priority', 'category', 'dueDate', 'updatedAt', 'completedAt'
           ])
        );

      allow delete: if isSignedIn() 
        && request.auth.token.email_verified == true
        && userId == request.auth.uid;
    }
  }
}
